<UserControl x:Class="UsbDeviceBridge.App.Views.Main.SetupOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource OverlayBg}"
             Visibility="Collapsed">
    <Border Width="680"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="28">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="First-time setup"
                           FontSize="26"
                           FontWeight="SemiBold"/>
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Ellipse x:Name="SetupDotOne"
                             Width="10"
                             Height="10"
                             Fill="{DynamicResource AccentBrush}"
                             Margin="0,0,8,0"/>
                    <Ellipse x:Name="SetupDotTwo"
                             Width="10"
                             Height="10"
                             Fill="{DynamicResource BorderBrush}"
                             Margin="0,0,8,0"/>
                    <Ellipse x:Name="SetupDotThree"
                             Width="10"
                             Height="10"
                             Fill="{DynamicResource BorderBrush}"
                             Margin="0,0,8,0"/>
                    <Ellipse x:Name="SetupDotFour"
                             Width="10"
                             Height="10"
                             Fill="{DynamicResource BorderBrush}"/>
                </StackPanel>
            </Grid>

            <Grid x:Name="SetupStepOnePanel"
                  Grid.Row="1"
                  MinHeight="180">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Margin="0,0,0,16"
                           Text="Pick a theme. The preview updates live — you can change it later in Settings."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMuted}"/>
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="SetupDarkCard"
                            Grid.Column="0"
                            Tag="Dark"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="2"
                            Padding="14">
                        <StackPanel>
                            <TextBlock x:Name="SetupDarkLabel"
                                       Text="Dark"
                                       FontSize="15"
                                       FontWeight="SemiBold"/>
                            <Rectangle x:Name="SetupDarkSwatch1"
                                       Height="7"
                                       Margin="0,12,80,0"
                                       RadiusX="4"
                                       RadiusY="4"/>
                            <Rectangle x:Name="SetupDarkSwatch2"
                                       Height="7"
                                       Margin="0,6,40,0"
                                       RadiusX="4"
                                       RadiusY="4"/>
                            <Rectangle x:Name="SetupDarkSwatch3"
                                       Height="7"
                                       Margin="0,6,100,0"
                                       RadiusX="4"
                                       RadiusY="4"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="SetupLightCard"
                            Grid.Column="2"
                            Tag="Light"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Padding="14">
                        <StackPanel>
                            <TextBlock x:Name="SetupLightLabel"
                                       Text="Light"
                                       FontSize="15"
                                       FontWeight="SemiBold"/>
                            <Rectangle x:Name="SetupLightSwatch1"
                                       Height="7"
                                       Margin="0,12,80,0"
                                       RadiusX="4"
                                       RadiusY="4"/>
                            <Rectangle x:Name="SetupLightSwatch2"
                                       Height="7"
                                       Margin="0,6,40,0"
                                       RadiusX="4"
                                       RadiusY="4"/>
                            <Rectangle x:Name="SetupLightSwatch3"
                                       Height="7"
                                       Margin="0,6,100,0"
                                       RadiusX="4"
                                       RadiusY="4"/>
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>

            <Grid x:Name="SetupStepTwoPanelPrereq"
                  Grid.Row="1"
                  MinHeight="180"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Margin="0,0,0,16"
                           Text="Checking for required system dependencies..."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMuted}"/>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SetupPrerequisitesStatus"/>
                </ScrollViewer>
            </Grid>

            <Grid x:Name="SetupStepThreePanelDistro"
                  Grid.Row="1"
                  MinHeight="180"
                  Visibility="Collapsed">
                <Grid x:Name="SetupDistroSelectionView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Margin="0,0,0,12"
                               Text="Select which WSL distros to configure with USB client packages (usbutils, linux-tools-generic, hwdata). You can skip this step."
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMuted}"/>
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="0,0,0,12">
                        <StackPanel x:Name="SetupDistroCheckboxes"/>
                    </ScrollViewer>
                    <Button x:Name="SetupInstallPackagesButton"
                            Grid.Row="2"
                            Content="Install packages"
                            Style="{StaticResource AccentBtn}"
                            HorizontalAlignment="Left"/>
                </Grid>

                <Grid x:Name="SetupDistroLogView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBox x:Name="SetupInstallLogText"
                             Grid.Row="0"
                             Margin="0,0,0,10"
                             FontFamily="Consolas, Courier New, monospace"
                             FontSize="11"
                             Foreground="{DynamicResource TextPrimary}"
                             Background="{DynamicResource CardBg}"
                             BorderThickness="1"
                             BorderBrush="{DynamicResource InputBorderBrush}"
                             Padding="10"
                             IsReadOnly="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled"
                             AcceptsReturn="True"
                             MinHeight="150"/>
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Button x:Name="SetupInstallStopButton"
                                Content="Stop"
                                Style="{StaticResource GhostBtn}"
                                Margin="0,0,8,0"/>
                        <Button x:Name="SetupInstallStartOverButton"
                                Content="Start over"
                                Style="{StaticResource GhostBtn}"
                                Visibility="Collapsed"/>
                    </StackPanel>
                </Grid>
            </Grid>

            <Grid x:Name="SetupStepFourPanel"
                  Grid.Row="1"
                  MinHeight="180"
                  Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock Margin="0,0,0,16"
                           Text="Choose startup and tray behavior. You can edit all of these later in Settings."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextMuted}"/>
                <StackPanel Grid.Row="1">
                    <CheckBox x:Name="SetupEnableTray"
                              Style="{StaticResource ModernCheckBox}"
                              Margin="0,0,0,14"
                              Content="Enable minimize-to-tray behavior"
                              IsChecked="True"/>
                    <CheckBox x:Name="SetupStartMinimized"
                              Style="{StaticResource ModernCheckBox}"
                              Margin="0,0,0,14"
                              Content="Start minimized on launch"/>
                    <CheckBox x:Name="SetupAutoRefresh"
                              Style="{StaticResource ModernCheckBox}"
                              Margin="0,0,0,14"
                              Content="Enable auto-refresh by default"
                              IsChecked="True"/>
                    <CheckBox x:Name="SetupAutoUpdate"
                              Style="{StaticResource ModernCheckBox}"
                              Margin="0,0,0,0"
                              Content="Enable update checks by default"
                              IsChecked="True"/>
                </StackPanel>
            </Grid>

            <StackPanel Grid.Row="2"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0">
                <Button x:Name="SetupBackButton"
                        Content="Back"
                        Style="{StaticResource GhostBtn}"
                        Width="110"
                        Margin="0,0,8,0"
                        IsEnabled="False"/>
                <Button x:Name="SetupNextButton"
                        Content="Next"
                        Style="{StaticResource AccentBtn}"
                        Width="110"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
