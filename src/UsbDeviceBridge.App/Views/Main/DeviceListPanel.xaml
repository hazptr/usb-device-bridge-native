<UserControl x:Class="UsbDeviceBridge.App.Views.Main.DeviceListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UsbDeviceBridge.App.ViewModels"
             Background="Transparent">
    <UserControl.Resources>
    <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
    <Geometry x:Key="ConnectPlugGeometry">
        M6,2 C6,1.45 6.45,1 7,1 H9 C9.55,1 10,1.45 10,2 V3 H11.2 C12.75,3 14,4.25 14,5.8 V8.2 C14,9.75 12.75,11 11.2,11 H10 V13.5 H8.8 V11 H7.2 V13.5 H6 V11 H4.8 C3.25,11 2,9.75 2,8.2 V5.8 C2,4.25 3.25,3 4.8,3 H6 Z

M3.4,5.8 V8.2 C3.4,8.97 4.03,9.6 4.8,9.6 H11.2 C11.97,9.6 12.6,8.97 12.6,8.2 V5.8 C12.6,5.03 11.97,4.4 11.2,4.4 H4.8 C4.03,4.4 3.4,5.03 3.4,5.8 Z

M6.5,0 H7.5 V2.5 H6.5 Z
M8.5,0 H9.5 V2.5 H8.5 Z
    </Geometry>
    <Geometry x:Key="RememberBookmarkGeometry">M4,2 L12,2 C12.55,2 13,2.45 13,3 L13,14 L8.5,11 L4,14 L4,3 C4,2.45 4.45,2 5,2 Z</Geometry>

    <Style x:Key="ActionIconButton"
           TargetType="Button"
           BasedOn="{StaticResource GhostBtn}">
        <Setter Property="Width"
            Value="32"/>
        <Setter Property="Height"
            Value="28"/>
        <Setter Property="Padding"
            Value="0"/>
        <Setter Property="Margin"
            Value="0,0,4,0"/>
    </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Service disconnected persistent banner -->
        <Border VerticalAlignment="Center"
                HorizontalAlignment="Center"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                Padding="32,22"
                CornerRadius="10"
                Panel.ZIndex="5"
                Visibility="{Binding IsReconnectPanelVisible, Converter={StaticResource BoolToVisConverter}}">
            <StackPanel HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                <ProgressBar IsIndeterminate="True"
                             Width="160"
                             Height="3"
                             Margin="0,0,0,14"
                             Foreground="{DynamicResource AccentBrush}"/>
                <TextBlock Text="{Binding ServiceRecoveryMessage}"
                           FontSize="14"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextPrimary}"
                           Margin="0,0,0,4"/>
                <TextBlock Text="{Binding ServiceRecoveryDetails}"
                           FontSize="12"
                           Foreground="{DynamicResource TextMuted}"
                           HorizontalAlignment="Center"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           MaxWidth="380"
                           Margin="0,0,0,14"/>
                <Button HorizontalAlignment="Center"
                        MinWidth="190"
                        Content="Restart Service"
                        Command="{Binding DataContext.RestartServiceCommand, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Button.Style>
                        <Style TargetType="Button"
                               BasedOn="{StaticResource AccentBtn}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsRestartServiceInProgress}" Value="True">
                                    <Setter Property="Content" Value="Starting..."/>
                                    <Setter Property="IsEnabled" Value="False"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{Binding LoadingVisibility}">
            <ProgressBar IsIndeterminate="True"
                         Width="200"
                         Height="4"
                         Margin="0,0,0,12"
                         Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="Loading devices..."
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="13"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <TextBlock Text="No USB devices found."
                   Foreground="{DynamicResource TextMuted}"
                   FontSize="13"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Visibility="{Binding EmptyVisibility}"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding ListVisibility}"
                      Padding="12,10,12,10">
            <ItemsControl x:Name="DeviceItemsControl" ItemsSource="{Binding Devices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DeviceViewModel}">
                        <Border x:Name="Card"
                                Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,0,6"
                                Padding="10,2"
                                MinHeight="52"
                                ClipToBounds="False">
                            <Grid ClipToBounds="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="BadgeBorder"
                                        Grid.Column="0"
                                        Background="{DynamicResource AvailableBg}"
                                        CornerRadius="6"
                                        Padding="4,6"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="BadgeText"
                                               Text="{Binding StatusLabel}"
                                               Foreground="{DynamicResource AvailableFg}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </Border>
                                <Grid Grid.Column="1"
                                      Margin="12,0,8,0"
                                      VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="{DynamicResource TextMuted}"
                                                   FontSize="11"
                                                   Margin="0,2,0,0"><Run Text="Bus "/><Run Text="{Binding BusId, Mode=OneWay}"/><Run Text="  |  "/><Run Text="{Binding HardwareId, Mode=OneWay}"/></TextBlock>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Column="2"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch"
                                      ClipToBounds="False">
                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,0"
                                                IsEnabled="{Binding DataContext.AreDeviceActionsEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Visibility="{Binding ActionsVisibility}">
                                        <ComboBox Style="{StaticResource DistroCombo}"
                                                  ItemsSource="{Binding DataContext.Distros, RelativeSource={RelativeSource AncestorType=Window}}"
                                                  SelectedItem="{Binding SelectedDistro}"
                                                  IsEnabled="{Binding CanSelectDistro}"
                                                  ToolTip="WSL distro to attach to"
                                                  Margin="-6,0,6,0"/>
                                        <Button ToolTip="Bind and attach device to WSL"
                                                Visibility="{Binding ConnectVisibility}"
                                                IsEnabled="{Binding CanConnect}"
                                                Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button"
                                                       BasedOn="{StaticResource ActionIconButton}">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Foreground"
                                                            Value="White"/>
                                                    <Setter Property="BorderThickness"
                                                            Value="0"/>
                                                </Style>
                                            </Button.Style>
                                            <Viewbox Width="12"
                                                     Height="12">
                                                <Path Data="{StaticResource ConnectPlugGeometry}"
                                                      Fill="White"
                                                      Stretch="Uniform"/>
                                            </Viewbox>
                                        </Button>
                                        <Button Style="{StaticResource ActionIconButton}"
                                                ToolTip="Detach from WSL and stop sharing"
                                                Visibility="{Binding DisconnectVisibility}"
                                                IsEnabled="{Binding CanDisconnect}"
                                                Command="{Binding DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                       Text="&#xE711;"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       VerticalAlignment="Center"/>
                                        </Button>
                                        <ToggleButton Style="{StaticResource BookmarkBtn}"
                                                      Width="32"
                                                      Height="28"
                                                      Padding="0"
                                                      Margin="0,0,4,0"
                                                      IsChecked="{Binding Remembered, Mode=OneWay}"
                                                      ToolTip="{Binding RememberTooltip}"
                                                      IsEnabled="{Binding HasInstanceId}"
                                                      Command="{Binding DataContext.ToggleRememberCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}">
                                            <Viewbox Width="12"
                                                     Height="12">
                                                <Path x:Name="BookmarkIcon"
                                                      Data="{StaticResource RememberBookmarkGeometry}"
                                                      Fill="Transparent"
                                                      Stroke="{DynamicResource TextMuted}"
                                                      StrokeThickness="1.5"
                                                      Stretch="Uniform"/>
                                            </Viewbox>
                                        </ToggleButton>
                                    </StackPanel>
                                    <StackPanel x:Name="BusyPane"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Center"
                                                Margin="0,0,0,0"
                                                Visibility="{Binding BusyVisibility}"
                                                Opacity="0">
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform x:Name="BusyPaneTranslate" X="18"/>
                                        </StackPanel.RenderTransform>
                                        <ProgressBar IsIndeterminate="True"
                                                     Width="80"
                                                     Height="3"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource AccentBrush}"
                                                     Margin="0,0,8,0"/>
                                        <TextBlock Text="Attaching..."
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding BusyVisibility}" Value="Visible">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BusyPane"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="1"
                                                             Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="BusyPaneTranslate"
                                                             Storyboard.TargetProperty="X"
                                                             From="18"
                                                             To="0"
                                                             Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BusyPane"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="BusyPaneTranslate"
                                                             Storyboard.TargetProperty="X"
                                                             To="10"
                                                             Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="attached">
                                <Setter TargetName="BadgeBorder"
                                        Property="Background"
                                        Value="{DynamicResource AttachedBg}"/>
                                <Setter TargetName="BadgeText"
                                        Property="Foreground"
                                        Value="{DynamicResource AttachedFg}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="shared">
                                <Setter TargetName="BadgeBorder"
                                        Property="Background"
                                        Value="{DynamicResource SharedBg}"/>
                                <Setter TargetName="BadgeText"
                                        Property="Foreground"
                                        Value="{DynamicResource SharedFg}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="offline">
                                <Setter TargetName="BadgeBorder"
                                        Property="Background"
                                        Value="{DynamicResource OfflineBg}"/>
                                <Setter TargetName="BadgeText"
                                        Property="Foreground"
                                        Value="{DynamicResource OfflineFg}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Remembered}" Value="True">
                                <Setter TargetName="BookmarkIcon"
                                        Property="Fill"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="BookmarkIcon"
                                        Property="Stroke"
                                        Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
