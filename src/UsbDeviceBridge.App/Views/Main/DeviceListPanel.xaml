<UserControl x:Class="UsbDeviceBridge.App.Views.Main.DeviceListPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UsbDeviceBridge.App.ViewModels"
             xmlns:main="clr-namespace:UsbDeviceBridge.App.Views.Main"
             Background="Transparent">
    <UserControl.Resources>
    <Geometry x:Key="ConnectPlugGeometry">M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244</Geometry>
    <Geometry x:Key="RememberBookmarkGeometry">M4,2 L12,2 C12.55,2 13,2.45 13,3 L13,14 L8.5,11 L4,14 L4,3 C4,2.45 4.45,2 5,2 Z</Geometry>

    <Style x:Key="ActionIconButton"
           TargetType="Button"
           BasedOn="{StaticResource GhostBtn}">
        <Setter Property="Width"
            Value="32"/>
        <Setter Property="Height"
            Value="28"/>
        <Setter Property="Padding"
            Value="0"/>
        <Setter Property="Margin"
            Value="0,0,4,0"/>
    </Style>
    </UserControl.Resources>

    <Grid>
        <main:ServiceRecoveryPromptControl Panel.ZIndex="5"/>

        <StackPanel VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Visibility="{Binding LoadingVisibility}">
            <ProgressBar IsIndeterminate="True"
                         Width="200"
                         Height="4"
                         Margin="0,0,0,12"
                         Foreground="{DynamicResource AccentBrush}"/>
            <TextBlock Text="Loading devices..."
                       Foreground="{DynamicResource TextMuted}"
                       FontSize="13"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <TextBlock Text="No USB devices found."
                   Foreground="{DynamicResource TextMuted}"
                   FontSize="13"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"
                   Visibility="{Binding EmptyVisibility}"/>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      Visibility="{Binding ListVisibility}"
                      Padding="12,10,12,10">
            <ItemsControl x:Name="DeviceItemsControl" ItemsSource="{Binding Devices}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:DeviceViewModel}">
                        <Border x:Name="Card"
                                Background="{DynamicResource CardBg}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Margin="0,0,0,6"
                                Padding="10,2"
                                MinHeight="52"
                                ClipToBounds="False">
                            <Grid ClipToBounds="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="82"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="220"/>
                                </Grid.ColumnDefinitions>
                                <Border x:Name="BadgeBorder"
                                        Grid.Column="0"
                                        Background="{DynamicResource AvailableBg}"
                                        CornerRadius="6"
                                        Padding="4,6"
                                        VerticalAlignment="Center">
                                    <TextBlock x:Name="BadgeText"
                                               Text="{Binding StatusLabel}"
                                               Foreground="{DynamicResource AvailableFg}"
                                               FontSize="10"
                                               FontWeight="SemiBold"
                                               TextAlignment="Center"
                                               TextWrapping="Wrap"/>
                                </Border>
                                <Grid Grid.Column="1"
                                      Margin="12,0,8,0"
                                      VerticalAlignment="Center">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Description}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Foreground="{DynamicResource TextMuted}"
                                                   FontSize="11"
                                                   Margin="0,2,0,0"><Run Text="Bus "/><Run Text="{Binding BusId, Mode=OneWay}"/><Run Text="  |  "/><Run Text="{Binding HardwareId, Mode=OneWay}"/></TextBlock>
                                    </StackPanel>
                                </Grid>
                                <Grid Grid.Column="2"
                                      VerticalAlignment="Center"
                                      HorizontalAlignment="Stretch"
                                      ClipToBounds="False">
                                    <StackPanel Grid.Column="0"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                            HorizontalAlignment="Right"
                                                Margin="0,0,0,0"
                                                IsEnabled="{Binding DataContext.AreDeviceActionsEnabled, RelativeSource={RelativeSource AncestorType=Window}}"
                                                Visibility="{Binding ActionsVisibility}">
                                        <Button ToolTip="{Binding ConnectTooltip}"
                                                Visibility="{Binding ConnectVisibility}"
                                                IsEnabled="{Binding CanConnect}"
                                                Command="{Binding DataContext.ConnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <Button.Style>
                                                <Style TargetType="Button"
                                                       BasedOn="{StaticResource ActionIconButton}">
                                                    <Setter Property="Background"
                                                            Value="{DynamicResource AccentBrush}"/>
                                                    <Setter Property="Foreground"
                                                            Value="White"/>
                                                    <Setter Property="BorderThickness"
                                                            Value="0"/>
                                                </Style>
                                            </Button.Style>
                                            <Viewbox Width="12"
                                                     Height="12">
                                                <Path Data="{StaticResource ConnectPlugGeometry}"
                                                      Fill="White"
                                                      Stretch="Uniform"/>
                                            </Viewbox>
                                        </Button>
                                        <Button Style="{StaticResource ActionIconButton}"
                                                ToolTip="Detach from WSL and stop sharing"
                                                Visibility="{Binding DisconnectVisibility}"
                                                IsEnabled="{Binding CanDisconnect}"
                                                Command="{Binding DataContext.DisconnectCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                                       Text="&#xE711;"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       VerticalAlignment="Center"/>
                                        </Button>
                                        <ToggleButton Style="{StaticResource BookmarkBtn}"
                                                      Width="32"
                                                      Height="28"
                                                      Padding="0"
                                                      Margin="0,0,4,0"
                                                      IsChecked="{Binding Remembered, Mode=OneWay}"
                                                      ToolTip="{Binding RememberTooltip}"
                                                      IsEnabled="{Binding HasInstanceId}"
                                                      Command="{Binding DataContext.ToggleRememberCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                      CommandParameter="{Binding}">
                                            <Viewbox Width="12"
                                                     Height="12">
                                                <Path x:Name="BookmarkIcon"
                                                      Data="{StaticResource RememberBookmarkGeometry}"
                                                      Fill="Transparent"
                                                      Stroke="{DynamicResource TextMuted}"
                                                      StrokeThickness="1.5"
                                                      Stretch="Uniform"/>
                                            </Viewbox>
                                        </ToggleButton>
                                    </StackPanel>
                                    <StackPanel x:Name="BusyPane"
                                                Orientation="Horizontal"
                                                VerticalAlignment="Center"
                                                HorizontalAlignment="Right"
                                                Margin="0,0,0,0"
                                                Visibility="{Binding BusyVisibility}"
                                                Opacity="0">
                                        <StackPanel.RenderTransform>
                                            <TranslateTransform x:Name="BusyPaneTranslate" X="18"/>
                                        </StackPanel.RenderTransform>
                                        <ProgressBar IsIndeterminate="True"
                                                     Width="80"
                                                     Height="3"
                                                     VerticalAlignment="Center"
                                                     Foreground="{DynamicResource AccentBrush}"
                                                     Margin="0,0,8,0"/>
                                        <TextBlock Text="Attaching..."
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   FontSize="11"
                                                   VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding BusyVisibility}" Value="Visible">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BusyPane"
                                                             Storyboard.TargetProperty="Opacity"
                                                             From="0"
                                                             To="1"
                                                             Duration="0:0:0.2"/>
                                            <DoubleAnimation Storyboard.TargetName="BusyPaneTranslate"
                                                             Storyboard.TargetProperty="X"
                                                             From="18"
                                                             To="0"
                                                             Duration="0:0:0.2">
                                                <DoubleAnimation.EasingFunction>
                                                    <CubicEase EasingMode="EaseOut"/>
                                                </DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="BusyPane"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0"
                                                             Duration="0:0:0.12"/>
                                            <DoubleAnimation Storyboard.TargetName="BusyPaneTranslate"
                                                             Storyboard.TargetProperty="X"
                                                             To="10"
                                                             Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="attached">
                                <Setter TargetName="BadgeBorder"
                                        Property="Background"
                                        Value="{DynamicResource AttachedBg}"/>
                                <Setter TargetName="BadgeText"
                                        Property="Foreground"
                                        Value="{DynamicResource AttachedFg}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="shared">
                                <Setter TargetName="BadgeBorder"
                                        Property="Background"
                                        Value="{DynamicResource SharedBg}"/>
                                <Setter TargetName="BadgeText"
                                        Property="Foreground"
                                        Value="{DynamicResource SharedFg}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding State}" Value="offline">
                                <Setter TargetName="BadgeBorder"
                                        Property="Background"
                                        Value="{DynamicResource OfflineBg}"/>
                                <Setter TargetName="BadgeText"
                                        Property="Foreground"
                                        Value="{DynamicResource OfflineFg}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Remembered}" Value="True">
                                <Setter TargetName="BookmarkIcon"
                                        Property="Fill"
                                        Value="{DynamicResource AccentBrush}"/>
                                <Setter TargetName="BookmarkIcon"
                                        Property="Stroke"
                                        Value="{DynamicResource AccentBrush}"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>
