<UserControl x:Class="UsbDeviceBridge.App.Views.Main.SettingsOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:main="clr-namespace:UsbDeviceBridge.App.Views.Main"
             Background="{DynamicResource OverlayBg}"
             Visibility="Collapsed">
    <UserControl.Resources>
        <Style x:Key="SettingHintIcon" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Text" Value="&#xE946;"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Grid">
            <Setter Property="MinHeight" Value="32"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="{x:Null}">
                    <Setter Property="MinHeight" Value="0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>
    <Border x:Name="SettingsPanelShell"
            Width="840"
            Height="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource SurfaceBg}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="12">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Settings"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondary}"
                           VerticalAlignment="Center"/>
                <Button x:Name="CloseSettingsButton"
                        Grid.Column="1"
                        Style="{StaticResource IconBtn}"
                        Width="30"
                        Height="30"
                        ToolTip="Close settings"
                        Click="CloseSettingsButton_OnClick">
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                               Text="&#xE8BB;"
                               FontSize="10"
                               Foreground="{DynamicResource TextMuted}"
                               VerticalAlignment="Center"/>
                </Button>
            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="240"/>
                    <ColumnDefinition Width="1"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,10,0">
                    <Grid>
                        <TextBox x:Name="SettingsSearchBox"
                                 TextChanged="SettingsSearchBox_OnTextChanged"
                                 ToolTip="Search settings"/>
                        <TextBlock Text="Search settings..."
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMuted}"
                                   IsHitTestVisible="False">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock"
                                       BasedOn="{StaticResource {x:Type TextBlock}}">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=SettingsSearchBox}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                    <StackPanel x:Name="SettingsSectionFiltersHost"
                                Margin="0,10,0,0"
                                Orientation="Vertical"/>
                </StackPanel>
                <Rectangle Grid.Column="1"
                           Fill="{DynamicResource BorderBrush}"/>
                <ScrollViewer Grid.Column="3"
                              VerticalScrollBarVisibility="Auto"
                              Padding="0,0,10,0">
                    <StackPanel x:Name="SettingsSectionsRoot">
                        <Border x:Name="SettingsSectionVersion"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0"
                                Padding="0,0,0,0"
                                Margin="0,0,0,0">
                            <StackPanel>
                                <TextBlock Text="Version info"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <Grid x:Name="SettingRowFrontendVersion"
                                      Tag="version frontend app ui build"
                                      Margin="0,0,0,8"
                                      ToolTip="Shows the desktop app version currently running.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Frontend version"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource SettingHintIcon}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding FrontendVersion}"
                                               Foreground="{DynamicResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <Grid x:Name="SettingRowBackendVersion"
                                      Tag="version backend service api"
                                      Margin="0,0,0,8"
                                      ToolTip="Shows the Windows service version used by the app.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Backend version"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource SettingHintIcon}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding BackendVersion}"
                                               Foreground="{DynamicResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <Grid x:Name="SettingRowWslVersion"
                                      Tag="version wsl system"
                                      Margin="0,0,0,8"
                                      ToolTip="Shows the WSL runtime version detected on this machine.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="WSL version"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource SettingHintIcon}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding WslVersion}"
                                               Foreground="{DynamicResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <Grid x:Name="SettingRowUsbIpdVersion"
                                      Tag="version usbipd system"
                                      Margin="0,0,0,8"
                                      ToolTip="Shows the installed usbipd-win version used for USB/IP operations.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="usbipd version"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource SettingHintIcon}"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding UsbIpdVersion}"
                                               Foreground="{DynamicResource TextPrimary}"
                                               VerticalAlignment="Center"/>
                                </Grid>
                                <Grid x:Name="SettingRowCopyVersionInfo"
                                      Tag="version copy diagnostics support"
                                      Margin="0,0,0,0"
                                      ToolTip="Copies frontend, backend, WSL, and usbipd versions for support and diagnostics.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Copy all version info"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource SettingHintIcon}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Copy"
                                            Style="{StaticResource GhostBtn}"
                                            Click="CopyVersionInfo_OnClick"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SettingsSectionSetup"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,10,0,0"
                                Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Setup and updates"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <Grid x:Name="SettingRowUsbIpCheck"
                                                                            Tag="check updates usbip setup status install prerequisites"
                                      Margin="0,0,0,8"
                                      ToolTip="Runs setup checks and shows whether required USB/IP prerequisites are installed and ready.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Check USBIP setup status"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource SettingHintIcon}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                                                                        Content="Check status"
                                            Style="{StaticResource GhostBtn}"
                                            Click="CheckUsbIp_OnClick"/>
                                </Grid>
                                <Grid x:Name="SettingRowUsbIpDocs"
                                      Tag="usbip docs help"
                                      Margin="0,0,0,8"
                                      ToolTip="Opens setup docs with installation and troubleshooting instructions.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Open setup documentation"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource SettingHintIcon}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Open docs"
                                            Style="{StaticResource GhostBtn}"
                                            Click="OpenUsbIpDocs_OnClick"/>
                                </Grid>
                                <Grid x:Name="SettingRowReset"
                                      Tag="reset setup preferences onboarding"
                                      Margin="0,0,0,0"
                                      ToolTip="Clears setup completion state and shows onboarding/setup prompts again.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Reset first-run setup"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource SettingHintIcon}"/>
                                    </StackPanel>
                                    <Button Grid.Column="1"
                                            Content="Reset"
                                            Style="{StaticResource GhostBtn}"
                                            Click="ResetSetup_OnClick"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SettingsSectionDevices"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,10,0,0"
                                Margin="0,10,0,0">
                            <StackPanel>
                            <TextBlock Text="Behavior"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <Grid x:Name="SettingRowAutoRefresh"
                                      Tag="auto refresh device list"
                                      Margin="0,0,0,8"
                                      ToolTip="Keeps the device list updated automatically without manual refresh.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Auto-refresh device list"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource SettingHintIcon}"/>
                                    </StackPanel>
                                    <CheckBox Style="{StaticResource ModernCheckBox}"
                                              Grid.Column="1"
                                              IsChecked="{Binding AutoRefreshEnabled, Mode=TwoWay}"/>
                                </Grid>
                                  <Grid x:Name="SettingRowSort"
                                      Tag="sort order devices"
                                      Margin="0,0,0,8"
                                      ToolTip="Chooses how devices are ordered in the main device list.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Sort order"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource SettingHintIcon}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              Style="{StaticResource DistroCombo}"
                                              Width="190"
                                              ItemsSource="{Binding SortOrders}"
                                              SelectedItem="{Binding SortOrderSelected, Mode=TwoWay}"/>
                                </Grid>
                                <Grid x:Name="SettingRowDetachOnExit"
                                      Tag="detach unbind exit close release devices shutdown"
                                      Margin="0,0,0,0"
                                      ToolTip="Detaches and unbinds USB/IP devices on app exit to leave a clean host state.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Release devices when app exits"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource SettingHintIcon}"/>
                                    </StackPanel>
                                    <CheckBox Style="{StaticResource ModernCheckBox}"
                                              Grid.Column="1"
                                              IsChecked="{Binding DetachOnExitEnabled, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SettingsSectionClients"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,10,0,0"
                                Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Clients"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <Grid x:Name="SettingRowClientsSelector"
                                      Tag="clients add ssh wsl target dropdown detected list remove setup packages sudo dnf pacman apt"
                                      Margin="0,0,0,0"
                                      ToolTip="Manage passthrough target clients and add SSH targets.">
                                    <main:SettingsClientsSelectorControl x:Name="SettingsClientsSelector"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SettingsSectionWindow"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,10,0,0"
                                Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Window"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <Grid x:Name="SettingRowTray"
                                      Tag="tray minimize to tray"
                                      Margin="0,0,0,8"
                                      ToolTip="Minimize the app to the system tray instead of the taskbar.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Minimize to tray"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource SettingHintIcon}"/>
                                    </StackPanel>
                                    <CheckBox Style="{StaticResource ModernCheckBox}"
                                              Grid.Column="1"
                                              IsChecked="{Binding MinimizeToTrayEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <Grid x:Name="SettingRowStartMin"
                                      Tag="start minimized startup launch"
                                      Margin="0,0,0,8"
                                      ToolTip="Launches the app in a minimized window state.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Start minimized"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource SettingHintIcon}"/>
                                    </StackPanel>
                                    <CheckBox Style="{StaticResource ModernCheckBox}"
                                              Grid.Column="1"
                                              IsChecked="{Binding StartMinimizedEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <Grid x:Name="SettingRowStartWithWindows"
                                      Tag="start with windows login startup"
                                      Margin="0,0,0,8"
                                      ToolTip="Starts the app automatically when you sign in to Windows.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Start with Windows"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource SettingHintIcon}"/>
                                    </StackPanel>
                                    <CheckBox Style="{StaticResource ModernCheckBox}"
                                              Grid.Column="1"
                                              IsChecked="{Binding StartWithWindowsEnabled, Mode=TwoWay}"/>
                                </Grid>
                                <Grid x:Name="SettingRowServiceStartupMode"
                                      Tag="service startup mode automatic on-demand manual"
                                      Margin="0,0,0,8"
                                      ToolTip="Controls whether the service starts automatically or only when needed.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Service startup mode"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource SettingHintIcon}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              Style="{StaticResource DistroCombo}"
                                              Width="190"
                                              ItemsSource="{Binding ServiceStartupModes}"
                                              SelectedItem="{Binding ServiceStartupModeSelected, Mode=TwoWay}"/>
                                </Grid>
                                <Grid x:Name="SettingRowFirewallRecoveryPolicy"
                                      Tag="firewall recovery policy ask always never"
                                      Margin="0,0,0,8"
                                      ToolTip="Defines how the app handles missing firewall rules during setup and startup.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Firewall recovery policy"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource SettingHintIcon}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              Style="{StaticResource DistroCombo}"
                                              Width="190"
                                              ItemsSource="{Binding FirewallFixPolicyOptions}"
                                              SelectedItem="{Binding FirewallFixPolicySelected, Mode=TwoWay}"/>
                                </Grid>
                                <Grid x:Name="SettingRowSshPortForwardMode"
                                      Tag="ssh forwarding tunnel attach remote"
                                      Margin="0,0,0,0"
                                      ToolTip="Selects how SSH tunnels are used when attaching devices to remote clients.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="SSH forwarding mode"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource SettingHintIcon}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              Style="{StaticResource DistroCombo}"
                                              Width="190"
                                              ItemsSource="{Binding SshPortForwardModeOptions}"
                                              SelectedItem="{Binding SshPortForwardModeSelected, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SettingsSectionNotifications"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,10,0,0"
                                Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Notifications"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <Grid x:Name="SettingRowWindowsNotifications"
                                      Tag="notifications windows os action center background"
                                      Margin="0,0,0,0"
                                      ToolTip="When enabled, Windows native notifications are shown while the app is not in the foreground.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="Windows notifications"
                                                       Foreground="{DynamicResource TextSecondary}"
                                                       VerticalAlignment="Center"/>
                                            <TextBlock Style="{StaticResource SettingHintIcon}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <CheckBox Style="{StaticResource ModernCheckBox}"
                                              Grid.Column="1"
                                              IsChecked="{Binding WindowsNotificationsEnabled, Mode=TwoWay}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SettingsSectionAppearance"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,10,0,0"
                                Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Appearance"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <Grid x:Name="SettingRowTheme"
                                      Tag="theme dark light appearance"
                                      Margin="0,0,0,8"
                                      ToolTip="Switches the application visual theme.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Theme"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource SettingHintIcon}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              Style="{StaticResource DistroCombo}"
                                              Width="160"
                                              ItemsSource="{Binding AvailableThemes}"
                                              SelectedItem="{Binding SelectedTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="SettingsSectionUpdates"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="0,10,0,0"
                                Margin="0,10,0,0">
                            <StackPanel>
                                <TextBlock Text="Updates"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Margin="0,0,0,8"/>
                                <Grid x:Name="SettingRowUpdateMode"
                                      Tag="updates auto check releases github install download notify"
                                      Margin="0,0,0,8"
                                      ToolTip="Automatic install: download new releases and prompt to install.&#10;Notify only: show a link to the releases page.&#10;Disabled: no checks.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock Text="Update checks"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Style="{StaticResource SettingHintIcon}"/>
                                    </StackPanel>
                                    <ComboBox Grid.Column="1"
                                              Style="{StaticResource DistroCombo}"
                                              Width="190"
                                              VerticalAlignment="Center"
                                              ItemsSource="{Binding UpdateCheckModeOptions}"
                                              SelectedItem="{Binding UpdateCheckModeSelected, Mode=TwoWay}"/>
                                </Grid>
                                <Grid x:Name="SettingRowCheckUpdates"
                                      Tag="updates check now releases"
                                      Margin="0,0,0,8"
                                      ToolTip="Runs an immediate update check using the configured update mode.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <TextBlock x:Name="SettingsCheckUpdatesStatus"
                                                   Text="Check for updates now"
                                                   Foreground="{DynamicResource TextSecondary}"/>
                                        <TextBlock Style="{StaticResource SettingHintIcon}"/>
                                    </StackPanel>
                                    <Button x:Name="SettingsCheckUpdatesButton"
                                            Grid.Column="1"
                                            Content="Check now"
                                            Style="{StaticResource GhostBtn}"
                                            Click="CheckForUpdates_OnClick"/>
                                </Grid>
                                <Grid x:Name="SettingRowOpenReleases"
                                      Tag="updates releases page github open browser"
                                      Margin="0,0,0,0"
                                      ToolTip="Opens the GitHub releases page in your browser.">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Open releases page"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Style="{StaticResource SettingHintIcon}"/>
                                    </StackPanel>
                                    <Button Content="Open"
                                            Grid.Column="1"
                                            Style="{StaticResource GhostBtn}"
                                            Click="OpenReleasesPage_OnClick"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Border>
</UserControl>

