<UserControl x:Class="UsbDeviceBridge.App.Views.Main.ToastOverlayControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:UsbDeviceBridge.App.ViewModels"
             Visibility="Collapsed">
    <Grid VerticalAlignment="Bottom"
          HorizontalAlignment="Center"
          Margin="0,0,0,14"
          IsHitTestVisible="True"
          Panel.ZIndex="10">
        <Grid.RenderTransform>
            <TranslateTransform x:Name="ToastTranslate"
                    Y="60"/>
        </Grid.RenderTransform>
        <Border x:Name="ToastBorder"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="14,10"
                MinWidth="320"
                MaxWidth="560">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20"
                        ShadowDepth="4"
                        Direction="270"
                                  Color="{DynamicResource ToastShadowColor}"
                        Opacity="0.4"/>
            </Border.Effect>
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background"
                            Value="{DynamicResource FeedbackSuccessBg}"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding FeedbackKind}"
                                Value="{x:Static vm:ToastKind.Error}">
                            <Setter Property="Background"
                                    Value="{DynamicResource FeedbackErrorBg}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding FeedbackKind}"
                                Value="{x:Static vm:ToastKind.Warning}">
                            <Setter Property="Background"
                                    Value="{DynamicResource FeedbackWarningBg}"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding FeedbackKind}"
                                Value="{x:Static vm:ToastKind.Info}">
                            <Setter Property="Background"
                                    Value="{DynamicResource FeedbackInfoBg}"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <!-- Kind icon -->
                <TextBlock x:Name="ToastIcon"
                           Grid.Column="0"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="15"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Text"
                                    Value="&#xE73E;"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource SuccessBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FeedbackKind}"
                                        Value="{x:Static vm:ToastKind.Error}">
                                    <Setter Property="Text"
                                            Value="&#xE711;"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource ErrorBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding FeedbackKind}"
                                        Value="{x:Static vm:ToastKind.Warning}">
                                    <Setter Property="Text"
                                            Value="&#xE7BA;"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource WarningBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding FeedbackKind}"
                                        Value="{x:Static vm:ToastKind.Info}">
                                    <Setter Property="Text"
                                            Value="&#xE946;"/>
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource InfoBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Message -->
                <TextBlock Grid.Column="1"
                           Text="{Binding FeedbackMessage}"
                           FontSize="13"
                           VerticalAlignment="Center"
                           TextWrapping="Wrap"
                           Margin="0,0,12,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock"
                                BasedOn="{StaticResource {x:Type TextBlock}}">
                            <Setter Property="Foreground"
                                    Value="{DynamicResource SuccessBrush}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FeedbackKind}"
                                        Value="{x:Static vm:ToastKind.Error}">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource ErrorBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding FeedbackKind}"
                                        Value="{x:Static vm:ToastKind.Warning}">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource WarningBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding FeedbackKind}"
                                        Value="{x:Static vm:ToastKind.Info}">
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource InfoBrush}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <!-- Dismiss button -->
                <Button Grid.Column="2"
                        Command="{Binding DismissToastCommand}"
                        VerticalAlignment="Center"
                        ToolTip="Dismiss">
                    <Button.Style>
                        <Style TargetType="Button"
                                BasedOn="{StaticResource IconBtn}">
                            <Setter Property="Width"
                                    Value="24"/>
                            <Setter Property="Height"
                                    Value="24"/>
                            <Setter Property="Padding"
                                    Value="4"/>
                            <Setter Property="Foreground"
                                    Value="{DynamicResource TextMuted}"/>
                        </Style>
                    </Button.Style>
                    <TextBlock FontFamily="Segoe MDL2 Assets"
                            Text="&#xE8BB;"
                            FontSize="9"/>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>
