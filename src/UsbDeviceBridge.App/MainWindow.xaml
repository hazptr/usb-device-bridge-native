<Window x:Class="UsbDeviceBridge.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:vm="clr-namespace:UsbDeviceBridge.App.ViewModels"
        xmlns:main="clr-namespace:UsbDeviceBridge.App.Views.Main"
        Title="USB Device Bridge for WSL"
        Icon="Assets/app_icon.ico"
        Width="980"
        Height="700"
        MinWidth="720"
        MinHeight="480"
        Background="{DynamicResource PageBg}"
        WindowStyle="None"
        ResizeMode="CanResize"
        BorderBrush="{DynamicResource BorderBrush}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Geometry x:Key="ConnectPlugGeometry">M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244</Geometry>
        <Geometry x:Key="RememberBookmarkGeometry">M4,2 L12,2 C12.55,2 13,2.45 13,3 L13,14 L8.5,11 L4,14 L4,3 C4,2.45 4.45,2 5,2 Z</Geometry>

        <Style x:Key="ActionIconButton"
                TargetType="Button"
                BasedOn="{StaticResource GhostBtn}">
            <Setter Property="Width"
                    Value="32"/>
            <Setter Property="Height"
                    Value="28"/>
            <Setter Property="Padding"
                    Value="0"/>
            <Setter Property="Margin"
                    Value="0,0,4,0"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource PageBg}">
        <Rectangle Stroke="{DynamicResource BorderBrush}"
                StrokeThickness="1"
                RadiusX="8"
                RadiusY="8"/>

        <Border Background="{DynamicResource PageBg}"
                CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0"
                        Background="{DynamicResource HeaderBg}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,0,1"
                        MouseLeftButtonDown="TitleBar_OnMouseLeftButtonDown">
                    <Grid Height="40">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="USB Device Bridge for WSL"
                                    FontWeight="SemiBold"/>
                            <TextBlock Text="  •  "
                                    Foreground="{DynamicResource TextMuted}"/>
                            <TextBlock Text="{Binding StatusText}"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextMuted}"/>
                        </StackPanel>
                        <StackPanel x:Name="ShellOptionsPanel"
                                Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Margin="0,0,8,0">
                                <Button ToolTip="Refresh now"
                                    Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Margin="0,0,6,0">
                                <Button.Style>
                                    <Style TargetType="Button"
                                            BasedOn="{StaticResource IconBtn}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding DataContext.IsAutoRefresh, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    Value="True">
                                                <Setter Property="Visibility"
                                                        Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                        Text="&#xE72C;"
                                        FontSize="14"/>
                            </Button>
                            <Grid>
                                <Button Style="{StaticResource IconBtn}"
                                        ToolTip="Notifications"
                                        Click="NotificationMenuButton_OnClick">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE7ED;"
                                               FontSize="14"/>
                                </Button>
                                <Border x:Name="NotificationBadge"
                                        Width="8"
                                        Height="8"
                                        CornerRadius="4"
                                        Background="{DynamicResource ErrorBrush}"
                                        BorderBrush="{DynamicResource HeaderBg}"
                                        BorderThickness="1"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top"
                                        Margin="0,3,3,0"
                                        Visibility="Collapsed"/>
                            </Grid>
                            <Button Style="{StaticResource IconBtn}"
                                    ToolTip="Settings"
                                    Click="OpenSettingsButton_OnClick">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                           Text="&#xE713;"
                                           FontSize="14"/>
                            </Button>
                        </StackPanel>
                        <StackPanel Grid.Column="2"
                                Orientation="Horizontal">
                            <Button Style="{StaticResource TitleBarWindowButton}"
                                    Click="MinimizeButton_OnClick"
                                    ToolTip="Minimize">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                        Text="&#xE921;"
                                        FontSize="10"
                                        VerticalAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource TitleBarWindowButton}"
                                    Click="MaximizeButton_OnClick"
                                    ToolTip="Maximize or restore">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                        Text="&#xE922;"
                                        FontSize="10"
                                        VerticalAlignment="Center"/>
                            </Button>
                            <Button Style="{StaticResource TitleBarCloseButton}"
                                    Click="CloseButton_OnClick"
                                    ToolTip="Close">
                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                        Text="&#xE8BB;"
                                        FontSize="10"
                                        VerticalAlignment="Center"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <main:DeviceListPanel x:Name="DeviceListPanel"/>
                </Grid>

                <main:ToastOverlayControl x:Name="ToastMenuPanel"
                                          Grid.RowSpan="2"/>

                <main:NotificationOverlayControl x:Name="NotificationMenuPanel"
                                                 Grid.RowSpan="2"/>

                <main:SetupOverlayControl x:Name="SetupOverlay"
                                          Grid.Row="1"/>

                <main:SettingsOverlayControl x:Name="SettingsOverlay"
                                             Grid.RowSpan="2"/>
            </Grid>
        </Border>
    </Grid>
</Window>
