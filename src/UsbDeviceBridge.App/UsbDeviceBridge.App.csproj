<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <InformationalVersion>1.0.0</InformationalVersion>
    <!-- Suppress the no-manifest warning for WinExe; handled by Windows App SDK later -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.3.2" />
    <PackageReference Include="Grpc.Net.Client" Version="2.71.0" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app_icon.ico" />
  </ItemGroup>

  <!--
    Auto-generate Themes/themes.manifest at build time.
    Lists every *Theme.xaml filename (one per line) so ThemeManager can
    discover themes without any hardcoded names.
    To add a theme: drop a new XxxTheme.xaml in the Themes/ folder and rebuild.
  -->
  <Target Name="GenerateThemesManifest" BeforeTargets="PrepareForBuild">
    <ItemGroup>
      <_ThemeFiles Include="Themes\*Theme.xaml" />
    </ItemGroup>
    <WriteLinesToFile File="Themes\themes.manifest"
                      Lines="@(_ThemeFiles->'%(Filename)%(Extension)')" 
                      Overwrite="true"
                      WriteOnlyWhenDifferent="true" />
  </Target>

  <ItemGroup>
    <Content Include="Themes\themes.manifest" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\UsbDeviceBridge.Protos\UsbDeviceBridge.Protos.csproj" />
  </ItemGroup>

</Project>
