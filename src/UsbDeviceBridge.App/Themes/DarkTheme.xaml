<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Theme discovery key — the app scans for this in every Themes/*.xaml file -->
    <sys:String x:Key="ThemeName">Dark</sys:String>

    <SolidColorBrush x:Key="PageBg" Color="#0B1220"/>
    <SolidColorBrush x:Key="SurfaceBg" Color="#0F172A"/>
    <SolidColorBrush x:Key="CardBg" Color="#111827"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#0F172A"/>
    <SolidColorBrush x:Key="StatusBarBg" Color="#0F172A"/>
    <SolidColorBrush x:Key="BorderSubtleBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#23324B"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#2DD4BF"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#14B8A6"/>
    <SolidColorBrush x:Key="TextPrimary" Color="#F8FAFC"/>
    <SolidColorBrush x:Key="TextSecondary" Color="#E2E8F0"/>
    <SolidColorBrush x:Key="TextMuted" Color="#94A3B8"/>
    <SolidColorBrush x:Key="SuccessBrush" Color="#34D399"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="#FCA5A5"/>
    <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="InfoBrush" Color="#60A5FA"/>

    <SolidColorBrush x:Key="AttachedBg" Color="#14532D"/>
    <SolidColorBrush x:Key="AttachedFg" Color="#34D399"/>
    <SolidColorBrush x:Key="SharedBg" Color="#713F12"/>
    <SolidColorBrush x:Key="SharedFg" Color="#FBBF24"/>
    <SolidColorBrush x:Key="AvailableBg" Color="#0F172A"/>
    <SolidColorBrush x:Key="AvailableFg" Color="#94A3B8"/>
    <SolidColorBrush x:Key="OfflineBg" Color="#312E81"/>
    <SolidColorBrush x:Key="OfflineFg" Color="#A78BFA"/>

    <SolidColorBrush x:Key="GhostHoverBrush" Color="#334155"/>
    <SolidColorBrush x:Key="CloseHoverBrush" Color="#CE3D3D"/>
    <SolidColorBrush x:Key="ComboBackgroundBrush" Color="#1E293B"/>
    <SolidColorBrush x:Key="FeedbackSuccessBg" Color="#14532D"/>
    <SolidColorBrush x:Key="FeedbackErrorBg" Color="#7F1D1D"/>
    <SolidColorBrush x:Key="FeedbackWarningBg" Color="#78350F"/>
    <SolidColorBrush x:Key="FeedbackInfoBg" Color="#1E3A5F"/>
    <Color x:Key="ToastShadowColor">#000000</Color>
    <SolidColorBrush x:Key="SidebarBg" Color="#0F172A"/>
    <SolidColorBrush x:Key="OverlayBg" Color="#CC0B1220"/>
    <SolidColorBrush x:Key="InputBorderBrush" Color="#334155"/>

</ResourceDictionary>