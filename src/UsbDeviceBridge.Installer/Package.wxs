<?xml version="1.0" encoding="UTF-8"?>
<!--
  USB Device Bridge — WiX v4 Installer
  ======================================
  Packages:
    • UsbDeviceBridge.App    → ProgramFiles64\USB Device Bridge\App\
    • UsbDeviceBridge.Service → ProgramFiles64\USB Device Bridge\Service\

  Service registration:
    • Name:       UsbDeviceBridge
    • Start type: Delayed Auto-Start (starts automatically after each Windows boot)
    • Account:    LocalSystem  (required for USB/IP kernel driver access)

  Build inputs (set via MSBuild properties or overridden by CI):
    • $(ServicePublishDir)  — output of: dotnet publish UsbDeviceBridge.Service -r win-x64
    • $(AppPublishDir)      — output of: dotnet publish UsbDeviceBridge.App    -r win-x64

  Silent install:   msiexec /i UsbDeviceBridgeSetup.msi /quiet
  Silent uninstall: msiexec /x UsbDeviceBridgeSetup.msi /quiet
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
  xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
  xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="USB Device Bridge"
           Manufacturer="USB Device Bridge"
           Version="$(var.PackageVersion)"
           UpgradeCode="{2ED74B0D-BA1C-4C84-A1AC-0D13D6B5BEF5}"
           Compressed="yes"
           InstallerVersion="500"
           Scope="perMachine">

    <!--
      MajorUpgrade: remove the old version before installing the new one.
      Prevents side-by-side installs and ensures clean upgrades.
    -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of USB Device Bridge is already installed." />

    <!-- Embed all files in a single CAB inside the MSI. -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <!-- Set ARP and shortcut icon to the app logo. -->
    <Icon Id="ProductIcon" SourceFile="..\UsbDeviceBridge.App\Assets\app_icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="ProductIcon" />

    <!-- Replace default WiX lorem ipsum license text with project MIT license. -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- Add a launch checkbox on ExitDialog after successful first-time install. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch USB Device Bridge" />

    <!-- Standard install-directory UI.  Set INSTALLFOLDER to override the root. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />

    <UI>
      <Publish Dialog="ExitDialog"
               Control="Finish"
               Event="DoAction"
               Value="LaunchInstalledApp"
               Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>

    <InstallExecuteSequence>
      <!--
        Production hardening for uninstall:
        Best-effort explicit stop/delete via sc.exe so the service entry is
        removed from Services even if MSI ServiceControl removal is skipped.
      -->
      <Custom Action="ForceStopServiceSc"
              Before="RemoveFiles"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="ForceDeleteServiceSc"
              After="ForceStopServiceSc"
              Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <!-- ═══════════════════════════════ Directory tree ════════════════════════════ -->

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="USB Device Bridge">
        <Directory Id="SERVICEDIR" Name="Service">
        </Directory>
        <Directory Id="APPDIR" Name="App" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="ApplicationProgramsFolder" Name="USB Device Bridge" />
    </StandardDirectory>

    <!-- ═══════════════════════════════ Features ═════════════════════════════════ -->

    <Feature Id="MainFeature" Title="USB Device Bridge" Level="1">
      <ComponentGroupRef Id="AppComponents" />
      <ComponentGroupRef Id="ServiceComponents" />
      <!-- ServiceHarvestedFiles and AppHarvestedFiles are generated by Harvest.ps1 at build time -->
      <ComponentGroupRef Id="ServiceHarvestedFiles" />
      <ComponentGroupRef Id="AppHarvestedFiles" />
      <ComponentGroupRef Id="ShortcutComponents" />
    </Feature>

  </Package>

  <Fragment>
    <!--
      Run the installed UI executable when the user ticks the optional ExitDialog checkbox.
      This is only offered on fresh install (NOT Installed).
    -->
    <CustomAction Id="LaunchInstalledApp"
                  FileRef="AppExe"
                  ExeCommand=""
                  Return="asyncNoWait"
                  Impersonate="yes" />

            <!-- Best-effort explicit uninstall cleanup for service registration. -->
            <CustomAction Id="ForceStopServiceSc"
                    Directory="System64Folder"
                    ExeCommand="sc.exe stop UsbDeviceBridge"
                    Execute="deferred"
                    Impersonate="no"
                    Return="ignore" />

            <CustomAction Id="ForceDeleteServiceSc"
                    Directory="System64Folder"
                    ExeCommand="sc.exe delete UsbDeviceBridge"
                    Execute="deferred"
                    Impersonate="no"
                    Return="ignore" />
  </Fragment>

  <Fragment>
    <ComponentGroup Id="AppComponents" Directory="APPDIR">
      <!-- Explicit app exe component so ExitDialog launch action can FileRef it reliably. -->
      <Component Id="AppExeComponent" Guid="*">
        <File Id="AppExe"
              Source="$(AppPublishDir)\UsbDeviceBridge.App.exe"
              KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>

  <!-- ─────────────────────────────── Service components ───────────────────────── -->
  <!--
    ServiceExeComponent holds the main service executable and owns the SCM registration.
    Remaining files are harvested at build time via Harvest.ps1 into ServiceHarvestedFiles.
  -->
  <Fragment>
    <ComponentGroup Id="ServiceComponents" Directory="SERVICEDIR">

      <!-- Main service executable — KeyPath drives the service binary path set in SCM. -->
      <Component Id="ServiceExeComponent" Guid="{53FE398C-24E4-444B-A98E-7FA48B589977}">
        <File Id="ServiceExe"
              Source="$(ServicePublishDir)\UsbDeviceBridge.Service.exe"
              KeyPath="yes" />

        <!--
          Register the Windows Service.
          Start="auto" + ServiceConfig DelayedAutoStart="yes" → Delayed Auto-Start,
          meaning Windows boots first and then starts the service a few seconds later.
          Account="LocalSystem" is required for USB/IP kernel-level access.
        -->
        <ServiceInstall Id="ServiceInstall"
                        Name="UsbDeviceBridge"
                        DisplayName="USB Device Bridge"
                        Description="Manages USB/IP device attachment to WSL distributions."
                        Start="auto"
                        Type="ownProcess"
                        Account="LocalSystem"
                        ErrorControl="normal" />

        <!--
          Production hardening:
          Enforce delayed auto-start via SCM registry value directly because MSI
          ServiceConfig delayed-auto-start authoring can be inconsistent on some
          machines/maintenance flows.
        -->

        <!--
          Service failure recovery policy (util extension): restart on first,
          second, and third failures with a 60-second delay.
        -->
        <util:ServiceConfig ServiceName="UsbDeviceBridge"
                            FirstFailureActionType="restart"
                            SecondFailureActionType="restart"
                            ThirdFailureActionType="restart"
                            ResetPeriodInDays="1"
                            RestartServiceDelayInSeconds="60" />

        <!--
          Service lifecycle during install/uninstall:
            install   → start the service immediately after registration
            uninstall → stop then remove the service
        -->
        <ServiceControl Id="ServiceControl"
                        Name="UsbDeviceBridge"
                        Start="install"
                        Stop="both"
                        Remove="uninstall"
                        Wait="yes" />
      </Component>

      <Component Id="ServiceDelayedAutoStartConfigComponent" Guid="*">
        <RegistryValue Root="HKLM"
                       Key="SYSTEM\CurrentControlSet\Services\UsbDeviceBridge"
                       Name="DelayedAutostart"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

    </ComponentGroup>
  </Fragment>

  <!-- ─────────────────────────────── Shortcut components ─────────────────────── -->

  <Fragment>
    <ComponentGroup Id="ShortcutComponents" Directory="ApplicationProgramsFolder">

      <Component Id="ShortcutComponent" Guid="{44DDDDBC-2FF3-4BE7-B399-FEB840A7A7BC}">
        <!-- Start Menu → USB Device Bridge → launch the UI. -->
        <Shortcut Id="AppStartMenuShortcut"
                  Name="USB Device Bridge"
                  Description="Manage USB device sharing with WSL distributions"
                  Icon="ProductIcon"
                  Target="[APPDIR]UsbDeviceBridge.App.exe"
                  WorkingDirectory="APPDIR" />

        <!-- Start Menu → USB Device Bridge → Uninstall (power-user convenience). -->
        <Shortcut Id="UninstallShortcut"
                  Name="Uninstall USB Device Bridge"
                  Icon="ProductIcon"
                  Target="[System64Folder]msiexec.exe"
                  Arguments="/x [ProductCode]" />

        <!-- Clean up Start Menu folder on uninstall. -->
        <RemoveFolder Id="RemoveApplicationProgramsFolder"
                      Directory="ApplicationProgramsFolder"
                      On="uninstall" />

        <!-- Registry key-path ensures the component has a durable identifier. -->
        <RegistryValue Root="HKCU"
                       Key="SOFTWARE\UsbDeviceBridge\Install"
                       Name="ShortcutInstalled"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>

    </ComponentGroup>
  </Fragment>

</Wix>
